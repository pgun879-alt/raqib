# raqib configuration.
#
# Copy to .env and edit. .env is git-ignored and must never be committed.
# Every value below is a PLACEHOLDER. Defaults are safe: robots.txt is honoured and private
# addresses are refused.

# ---------------------------------------------------------------- storage
RAQIB_DB_PATH=data/raqib.sqlite3
RAQIB_TARGETS_FILE=targets.yaml
RAQIB_REPORTS_DIR=reports

# ---------------------------------------------------------------- politeness
# Sent on every request. An identifiable agent with contact information is what lets a site owner
# tell a monitor from an attack. A browser-impersonating value is REFUSED at startup.
RAQIB_USER_AGENT=raqib/0.1 (+https://github.com/your-username/raqib; self-hosted monitor)

# Honour robots.txt. Disable ONLY for a site you own -- see the README's authorisation section.
RAQIB_RESPECT_ROBOTS=true

# Minimum gap between requests to the same host. A site's own Crawl-delay wins when stricter.
RAQIB_MIN_SECONDS_BETWEEN_REQUESTS_PER_HOST=2.0
RAQIB_MAX_CONCURRENT_REQUESTS=4
RAQIB_REQUEST_TIMEOUT_SECONDS=20
RAQIB_MAX_RESPONSE_BYTES=5242880
RAQIB_MAX_REDIRECTS=5

# ---------------------------------------------------------------- retries
RAQIB_MAX_ATTEMPTS=3
RAQIB_RETRY_BACKOFF_BASE_SECONDS=2.0

# ---------------------------------------------------------------- scheduling
# Random fraction of the interval added to each due time, so many targets sharing a schedule do
# not all fire in the same second.
RAQIB_SCHEDULER_JITTER_FRACTION=0.1

# ---------------------------------------------------------------- change detection
RAQIB_SNAPSHOT_HISTORY_LIMIT=20

# ---------------------------------------------------------------- safety
# Permit loopback and private addresses. Leave this FALSE unless you are watching a local test
# server. It disables part of the SSRF protection; the CLI warns whenever it is on.
RAQIB_ALLOW_PRIVATE_TARGETS=false

# ---------------------------------------------------------------- alerting
# Comma-separated: stdout, file, webhook, telegram
RAQIB_ALERT_SINKS=stdout,file
RAQIB_ALERT_FILE=data/alerts.jsonl

# Only needed for the "webhook" sink. PLACEHOLDER.
RAQIB_WEBHOOK_URL=https://hooks.example.com/replace-me

# Only needed for the "telegram" sink. PLACEHOLDERS -- never commit a real token.
RAQIB_TELEGRAM_BOT_TOKEN=123456789:replace-me-with-your-botfather-token
RAQIB_TELEGRAM_CHAT_ID=replace-me-with-your-chat-id

# ---------------------------------------------------------------- logging
RAQIB_LOG_LEVEL=INFO
